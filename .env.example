# Copier en .env (non versionné) : cp .env.example .env
#
# Le DSN est construit sans encodage par compose.yaml et par le Makefile :
# POSTGRES_USER et POSTGRES_PASSWORD ne doivent contenir aucun caractère
# à encoder dans une URL (notamment @ : / ? # % et espace).
POSTGRES_USER=datacat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datacat
